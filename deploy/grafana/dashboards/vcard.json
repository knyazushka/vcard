        "x": 0,
        "y": 13
      },
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "p95 по операциям",
      "description": "Вход и регистрация медленные намеренно: argon2id стоит десятки миллисекунд. Первая отрисовка карточки — тоже.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(vcard_http_request_duration_seconds_bucket{operation!~\"files|preflight\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
