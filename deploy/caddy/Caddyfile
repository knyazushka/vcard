# Caddy сам выпускает и продлевает сертификат Let's Encrypt для домена.
# Условие одно: A-запись домена уже указывает на этот сервер, а порты
# 80 и 443 открыты.
#
# Фронт на этом же сервере — ещё один такой же блок со своим доменом.

{$API_DOMAIN} {
	encode zstd gzip

	reverse_proxy api:8080 {
		# Идентификатор запроса выдаёт прокси, а не клиент: приложение
		# за доверенным прокси принимает его как есть, и присланный
		# снаружи X-Request-Id иначе попадал бы в логи.
		header_up X-Request-Id {http.request.uuid}
	}
}
