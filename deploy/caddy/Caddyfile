# Caddy сам выпускает и продлевает сертификат Let's Encrypt для домена.
# Условие одно: A-запись домена уже указывает на этот сервер, а порты
# 80 и 443 открыты.

(api) {
	reverse_proxy api:8080 {
		# Идентификатор запроса выдаёт прокси, а не клиент: приложение
		# за доверенным прокси принимает его как есть, и присланный
		# снаружи X-Request-Id иначе попадал бы в логи.
		header_up X-Request-Id {http.request.uuid}
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	import api
}

# Фронт — отдельный compose-проект на этом же сервере (репозиторий
# vcard-app), подключённый к сети этого; его контейнер — web.
#
# API на домене фронта — тот же api: браузер ходит на относительный
# /api/v1, и refresh-cookie с Path=/api/v1/auth остаётся first-party.
# Прямо в api, а не через переписывание в Next: лишний хоп ни к чему,
# а X-Forwarded-For выставляет сам Caddy, как и на домене API.
{$WEB_DOMAIN} {
	encode zstd gzip

	handle /api/v1/* {
		import api
	}

	# Пока фронт не выкачен, имя web не резолвится, и здесь 502 —
	# домен API это не задевает.
	handle {
		reverse_proxy web:3000
	}
}
