# Конфигурация целиком приходит из окружения — фактор III.
# Этот файл только образец: реальный .env в git не попадает, а в проде
# переменные ставит среда исполнения, никакого файла там нет вовсе.

APP_ENV=development
LOG_LEVEL=debug

HTTP_ADDR=:8080
HTTP_ADMIN_ADDR=:9090
# Включать только когда перед сервисом стоит доверенный прокси.
TRUST_PROXY_HEADERS=false

# Запросов в минуту с одного адреса; 0 выключает лимит. Строгий —
# для входа, регистрации и приглашений, общий — для остального API.
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_STRICT_PER_MINUTE=10

# Origin фронта, которому браузер разрешит читать ответы API. Точные
# значения через запятую, без слэша в конце. Пусто — CORS выключен.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 5433, а не 5432: порт разведён с локально установленным Postgres,
# чтобы окружение проекта нельзя было перепутать с чужой базой.
DATABASE_URL=postgres://vcard:vcard@localhost:5433/vcard?sslmode=disable

# Минимум 32 байта. Для локальной разработки сгодится что угодно длинное,
# в проде — секрет из хранилища среды, а не из этого файла.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/blobs
STORAGE_BASE_URL=http://localhost:8080/files

# Только для STORAGE_DRIVER=s3. Адрес и регион — из панели хранилища.
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@vcard.local

# Ссылки в письмах собираются только отсюда и никогда из заголовка Host
# входящего запроса.
PUBLIC_APP_URL=http://localhost:3000
INVITATION_TTL=168h
