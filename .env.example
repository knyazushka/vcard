# Конфигурация целиком приходит из окружения — фактор III.
# Этот файл только образец: реальный .env в git не попадает, а в проде
# переменные ставит среда исполнения, никакого файла там нет вовсе.

APP_ENV=development
LOG_LEVEL=debug

HTTP_ADDR=:8080
HTTP_ADMIN_ADDR=:9090
# Включать только когда перед сервисом стоит доверенный прокси.
TRUST_PROXY_HEADERS=false

# 5433, а не 5432: порт разведён с локально установленным Postgres,
# чтобы окружение проекта нельзя было перепутать с чужой базой.
DATABASE_URL=postgres://vcard:vcard@localhost:5433/vcard?sslmode=disable

# Минимум 32 байта. Для локальной разработки сгодится что угодно длинное,
# в проде — секрет из хранилища среды, а не из этого файла.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/blobs
STORAGE_BASE_URL=http://localhost:8080/files

SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@vcard.local

# Ссылки в письмах собираются только отсюда и никогда из заголовка Host
# входящего запроса.
PUBLIC_APP_URL=http://localhost:3000
INVITATION_TTL=168h
